<?xml version="1.0"?>
<package format="3">
  <name>nissan_bridge</name>
  <version>0.0.0</version>
  <description>C++ ROS 2 bridge node for Nissan LabVIEW integration.</description>
  <maintainer email="devnull@example.com">nissan_bridge team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nissan_bridge_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
